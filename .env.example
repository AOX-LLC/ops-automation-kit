# Copy to .env only if you need to change something. Every value below is the default.

# Stack name and host ports. A second checkout running alongside this one
# needs its own name and ports, for example ops-automation-kit-2 and 4310-4314.
COMPOSE_PROJECT_NAME=ops-automation-kit
KIT_N8N_PORT=4300
KIT_API_PORT=4301
KIT_PG_PORT=4302
KIT_MAILPIT_WEB_PORT=4303
KIT_MAILPIT_SMTP_PORT=4304

# Model mode: replay | live | record. Replay serves recorded responses, so no API key is
# needed. Live and record spend your own money and need the key below.
AGENT_CORE_MODE=replay

# Live and record modes only: your own Anthropic API key. Never commit a real key.
AGENT_CORE_ANTHROPIC_API_KEY=

  "id": "leads00000000001",
  "name": "Companies to enriched CRM records",
  "nodes": [
    {
      "id": "leads-note-01",
      "name": "Note 01",
      "parameters": {
        "content": "## Companies to enriched CRM records\nn8n orchestrates; the helper API does the work. It researches each company on the list, checks every quote it relies on against the page it came from, and writes only what it can source into the local CRM table, one source row per field. There are no Code nodes: the logic lives in the helper.\n\nA company with no website column value is reported as \"no website given\" and is not researched. A field with no verified source stays empty, and two sources that disagree are listed rather than picked between.\n\nA company whose research fails drops out of this run and the run still finishes; running the workflow again researches it and updates records rather than duplicating them.",
        "height": 240,
        "width": 620
      },
      "position": [
        -60,
        -320
      ],
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1
    },
    {

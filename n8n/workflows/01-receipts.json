      "id": "receipts-extract-01",
      "name": "Extract receipt",
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "jsonBody": "={{ { \"run_id\": $('Start run').item.json.run_id, \"path\": $json.path } }}",
        "method": "POST",
        "options": {
          "batching": {
            "batch": {
              "batchInterval": 500,
              "batchSize": 2

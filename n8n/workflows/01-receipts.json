      },
      "position": [
        2020,
        0
      ],
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1
    },
    {
      "id": "receipts-sheet-01",
      "name": "Spreadsheet",
      "parameters": {
        "binaryPropertyName": "data",
        "operation": "xlsx",
        "options": {
          "fileName": "=reconciliation-{{ $now.toFormat('yyyyLLdd-HHmm') }}.xlsx",

        "sendBody": true,
        "specifyBody": "json",
        "url": "http://api:8000/v1/receipts/extract"
      },
      "position": [
        1360,
        0
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2
    },
    {
      "id": "receipts-collect-01",
      "name": "Collect results",
      "parameters": {

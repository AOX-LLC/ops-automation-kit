  "id": "receipts00000001",
  "name": "Receipts → reconciled spreadsheet",
  "nodes": [
    {
      "id": "receipts-note-01",
      "name": "Note 01",
      "parameters": {
        "content": "## Receipts: n8n orchestrates, the helper works\nn8n starts a run, lists new receipts, calls the helper once per receipt to extract it, then asks the helper to reconcile the batch. The helper owns extraction and all the math; n8n only moves data, writes the spreadsheet to exports/ and sends the summary email. There are no Code nodes: if a step needs logic, it belongs in the helper.\nTriggers: every 15 minutes, or POST /webhook/receipts-run.",
        "height": 200,
        "width": 640
      },
      "position": [
        -60,
        -300
      ],
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1
    },
    {
      "id": "receipts-schedule-01",
      "name": "Every 15 minutes",
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "position": [
        0,
        0
      ],
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2
    },
    {
      "credentials": {
        "httpHeaderAuth": {
          "id": "kitWebhookAuth01",
          "name": "Kit webhooks (caller token)"
        }
      },
      "id": "receipts-webhook-01",
      "name": "Webhook",
      "parameters": {
        "authentication": "headerAuth",
        "httpMethod": "POST",
        "options": {},
        "path": "receipts-run",
        "responseMode": "onReceived"
      },
      "position": [
        0,
        200
      ],
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "webhookId": "8b2f6c4e-1a73-4d95-b0e8-5f3a9c7d2e02"
    },
    {
      "credentials": {
        "httpHeaderAuth": {
          "id": "kitApiAuth000001",
          "name": "Helper API (service token)"
        }
      },
      "id": "receipts-start-01",
      "name": "Start run",
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "jsonBody": "={{ { \"workflow\": \"receipts\", \"n8n_workflow_id\": $workflow.id, \"n8n_execution_id\": String($execution.id), \"scheduled\": $('Every 15 minutes').isExecuted } }}",
        "method": "POST",
        "options": {
          "timeout": 10000
        },
        "sendBody": true,
        "specifyBody": "json",
        "url": "http://api:8000/v1/runs"
      },
      "position": [
        260,
        100
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2
    },
    {
      "credentials": {
        "httpHeaderAuth": {
          "id": "kitApiAuth000001",
          "name": "Helper API (service token)"
        }
      },
      "id": "receipts-pending-01",
      "name": "List new receipts",
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "method": "GET",
        "options": {
          "timeout": 10000
        },
        "url": "http://api:8000/v1/receipts/pending?limit=100"
      },
      "position": [
        700,
        100
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2
    },
    {
      "id": "receipts-if-new-01",
      "name": "Anything new?",
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "id": "receipts-cond-new-01",
              "leftValue": "={{ $json.items.length }}",
              "operator": {
                "operation": "gt",
                "type": "number"
              },
              "rightValue": 0
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          }
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "position": [
        920,
        100
      ],
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2
    },
    {
      "credentials": {
        "httpHeaderAuth": {
          "id": "kitApiAuth000001",
          "name": "Helper API (service token)"
        }
      },
      "id": "receipts-finish-empty-01",
      "name": "Finish run (nothing new)",
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "jsonBody": "={{ { \"status\": \"succeeded\" } }}",
        "method": "POST",
        "options": {
          "timeout": 10000
        },
        "sendBody": true,
        "specifyBody": "json",
        "url": "=http://api:8000/v1/runs/{{ $('Start run').first().json.run_id }}/finish"
      },
      "position": [
        1140,
        300
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2
    },
    {
      "id": "receipts-split-01",

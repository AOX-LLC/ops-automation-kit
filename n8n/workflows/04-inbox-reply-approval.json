  "id": "inboxReply000001",
  "name": "Inbox reply approval",
  "nodes": [
    {
      "id": "reply-note-01",
      "name": "Note 01",
      "parameters": {
        "content": "## Inbox reply approval\nOne execution per draft, so each draft waits on its own signed resume URL. The branch reads the decision the helper recorded, never the resume request's body.\n\nThe release call is single use and bound to the exact payload the approver saw: n8n sends the to, subject and body it returns, nothing else.",
        "height": 200,
        "width": 620
      },
      "position": [
        -60,
        -300
      ],
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1
    },
    {
      "id": "reply-trigger-01",
      "name": "Draft to approve",
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            {
              "name": "draft_id",
              "type": "string"
            },
            {
              "name": "run_id",
              "type": "string"
            }
          ]
        }
      },
      "position": [
        0,
        0
      ],
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1
    },
    {
      "credentials": {
        "httpHeaderAuth": {
          "id": "kitApiAuth000001",
          "name": "Helper API (service token)"
        }
      },
      "id": "reply-approval-01",
      "name": "Request approval",
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "jsonBody": "={{ JSON.stringify({ run_id: $json.run_id, resume_url: $execution.resumeUrl }) }}",
        "method": "POST",
        "options": {
          "timeout": 10000
        },
        "sendBody": true,
        "specifyBody": "json",
        "url": "=http://api:8000/v1/inbox/drafts/{{ $json.draft_id }}/approval"
      },
      "position": [
        220,
        0
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2
    },
    {
      "id": "reply-wait-01",
      "name": "Wait for decision",
      "parameters": {
        "httpMethod": "POST",
        "limitType": "afterTimeInterval",
        "limitWaitTime": true,
        "options": {},
        "resume": "webhook",
        "resumeAmount": 72,
        "resumeUnit": "hours"
      },
      "position": [
        440,
        0
      ],
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "webhookId": "d9a3f5b7-2c4e-4b86-a1d0-7e6c8f2b4a04"
    },
    {
      "credentials": {

          "name": "Helper API (service token)"
        }
      },
      "id": "reply-check-01",
      "name": "Check recorded decision",
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "method": "GET",
        "options": {
          "timeout": 10000
        },
        "url": "=http://api:8000/v1/approvals/{{ $('Request approval').item.json.approval_id }}"
      },
      "position": [
        660,
        0
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2
    },
    {
